#!/usr/bin/env bash
set -euo pipefail

ZV_DIR="${ZV_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/zv}"
ZIG_DIR="${1:?Usage: $0 <zig-source-dir> [--no-build]}"
DO_BUILD=true
[[ "$*" == *--no-build* ]] && DO_BUILD=false

ZIG_DIR="$(cd "$ZIG_DIR" && pwd)"

if [[ -f "$ZIG_DIR/build/stage3/bin/zig" ]]; then
    BUILD_BIN="$ZIG_DIR/build/stage3/bin/zig"
    BUILD_CMD=(ninja -C "$ZIG_DIR/build" install)
elif [[ -f "$ZIG_DIR/stage3/bin/zig" ]]; then
    BUILD_BIN="$ZIG_DIR/stage3/bin/zig"
    BUILD_CMD=("$BUILD_BIN" build -p "$ZIG_DIR/stage3" --zig-lib-dir "$ZIG_DIR/lib" -Dno-lib)
else
    echo "No build found in $ZIG_DIR. Run cmake or zig build first." >&2
    exit 1
fi

$DO_BUILD && "${BUILD_CMD[@]}"

VERSION=$("$BUILD_BIN" version)
LOCAL_VERSION="${VERSION}-local"
TARGET_DIR="$ZV_DIR/versions/$LOCAL_VERSION"

rm -rf "$TARGET_DIR" && mkdir -p "$TARGET_DIR"
ln -sf "$BUILD_BIN" "$TARGET_DIR/zig"
ln -sf "$ZIG_DIR/lib" "$TARGET_DIR/lib"

echo "Installed: $LOCAL_VERSION"

read -rp "Set as active zig? [y/N] " confirm
if [[ "${confirm,,}" == "y" ]]; then
    ZV_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/zv/zv.toml"
    awk -v ver="$LOCAL_VERSION" -v path="$TARGET_DIR" '
        /^\[active_zig\]/ { in_section=1 }
        in_section && /^version / { print "version = \"" ver "\""; next }
        in_section && /^path /    { print "path = \""    path "\""; next }
        /^\[/ && !/^\[active_zig\]/ { in_section=0 }
        { print }
    ' "$ZV_CONFIG" > "$ZV_CONFIG.tmp" && mv "$ZV_CONFIG.tmp" "$ZV_CONFIG"
    echo "Activated."
fi
