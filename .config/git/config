[alias]
	nah = "!f(){ git reset --hard; git clean -df; if [ -d \".git/rebase-apply\" ] || [ -d \".git/rebase-merge\" ]; then git rebase --abort; fi; }; f"
	lg = "log --graph --abbrev-commit --decorate --date=format:'%Y-%m-%d %H:%M:%S' --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%ad%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'"
	squash = "!f(){ git reset --soft HEAD~${1} && git commit --edit -m\"$(git log --format=%B --reverse HEAD..HEAD@{1})\"; };f"
	subdiff = !git diff && git submodule foreach 'git diff'
	subpush = push --recurse-submodules=on-demand
	subupdate = submodule update --remote --merge
	au = !git add $(git ls-files -o --exclude-standard)
	tree = "!git log --graph --decorate --pretty=oneline --abbrev-commit"
	rank = "shortlog -s -n --no-merges"
	who = "blame -wCCC"
	which-tag = "name-rev --tags --name-only"
	file-added = "log --diff-filter=A --pretty=format:\"%H\""
	cite = "!f(){ git log -1 --format='%h (\"%s\")' $1; };f"
    nuke = "!f(){ git commit -as --amend --no-edit && git push --force-with-lease; };f"
	find-merge = "!f() { git log \"$1\"..${2:-master} --ancestry-path --merges --reverse --oneline | head -n 1; }; f"
	trace = "!f() { git log --graph --oneline --color --pretty=format:\"%C(magenta)%h%Creset %C(cyan)%ad%Creset %s %C(bold yellow)%d%Creset %C(bold black)(%an)%Creset\" --date=short \"$1\"..${2:-master}; }; f"

[gpg]
	program = gpg2

[commit]
	gpgsign = true
	verbose = true

[format]
	signoff = true

[core]
	editor = nvim
	autocrlf = input
	pager = delta

[init]
	defaultbranch = master

[pull]
	rebase = true

[push]
	recurseSubmodules = check

[rebase]
	autoStash = true
	autosquash = true

[merge]
	tool = nvimdiff
	conflictstyle = diff3

[diff]
    colorMoved = default
    tool = nvim_difftool

[difftool "nvim_difftool"]
    cmd = nvim -c \"DiffTool $LOCAL $REMOTE\"

[delta]
	navigate = true
	light = false

[interactive]
	diffFilter = delta --color-only

[color]
	ui = auto

[color "branch"]
	current = cyan bold reverse
	local = white
	plain = 
	remote = cyan

[color "diff"]
	commit = 
	func = cyan
	plain = 
	whitespace = magenta reverse
	meta = white
	frag = cyan bold reverse
	old = red
	new = green

[color "grep"]
	context = 
	filename = 
	function = 
	linenumber = white
	match = 
	selected = 
	separator = 

[color "interactive"]
	error = 
	header = 
	help = 
	prompt = 

[color "status"]
	added = green
	changed = white
	header = 
	localBranch = 
	nobranch = 
	remoteBranch = cyan bold
	unmerged = magenta bold reverse
	untracked = red
	updated = green bold

[rerere]
	enabled = false

[tag]
	sort = -taggerdate

[branch]
	sort = -committerdate

